# Docker-first deployment contract for identity-center.
# The backend stays on container-network port 8080 and is not exposed to the host.
# Version tag used by the release bundle compose file.
IDENTITY_CENTER_VERSION=v0.1.0
FRONTEND_PORT=11950

# Public issuer used by OAuth2 / OIDC metadata.
AUTH_ISSUER=https://website.example.com

# Optional identity labels.
AUTH_ADMIN_USERNAME=admin
AUTH_APP_USERNAME=app

# Token lifetimes.
# AUTH_APP_ACCESS_TTL=PT30M
# AUTH_TOKEN_ACCESS_TTL=PT30M

# Optional local upstream for mobile chat HTTP and WebSocket sync.
AP_UPSTREAM_BASE_URL=
CHAT_WS_UPSTREAM_URL=
# Optional Bearer token for AP upstream when it requires agent-platform auth.
# AP_UPSTREAM_ACCESS_TOKEN=

# Tunnel Hub public routing. Desktop agents use <device>.m.<base>, webapps use <route>.wa.<base>.
TUNNEL_HUB_BASE_DOMAIN=zenmind.cc
# Optional explicit relay websocket URL. Defaults to AUTH_ISSUER with /tunnel when empty.
# TUNNEL_HUB_RELAY_URL=wss://tunnel-hub.zenmind.cc/tunnel

# Required bcrypt values. Replace before production use and keep single quotes around hashes.
AUTH_ADMIN_PASSWORD_BCRYPT='$2a$10$VAC1MOfQV2f6L3LqgU5PweT25AdVaRK3yvMLwXjA0uRUhtnbbQ1ue'
AUTH_APP_MASTER_PASSWORD_BCRYPT='$2a$10$VAC1MOfQV2f6L3LqgU5PweT25AdVaRK3yvMLwXjA0uRUhtnbbQ1ue'
