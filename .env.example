# Docker-first deployment contract for identity-center.
# The backend stays on container-network port 8080 and is not exposed to the host.
# FRONTEND_PORT=11950

# Public issuer used by OAuth2 / OIDC metadata.
AUTH_ISSUER=https://website.example.com

# Optional identity labels.
AUTH_ADMIN_USERNAME=admin
AUTH_APP_USERNAME=app

# Token lifetimes.
# AUTH_APP_ACCESS_TTL=PT30M
# AUTH_TOKEN_ACCESS_TTL=PT30M

# Required bcrypt value. Replace before production use and keep single quotes around hashes.
AUTH_ADMIN_PASSWORD_BCRYPT='$2a$10$VAC1MOfQV2f6L3LqgU5PweT25AdVaRK3yvMLwXjA0uRUhtnbbQ1ue'

# Account email OTP. Disabled until SMTP sender and quotas are verified.
AUTH_EMAIL_LOGIN_ENABLED=false
AUTH_EMAIL_BIND_ENABLED=false
AUTH_EMAIL_DIGEST_KEY=
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=465
AUTH_SMTP_TLS=tls
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_FROM=
AUTH_SMTP_FROM_NAME=Zenmind
AUTH_SMTP_TIMEOUT_SECONDS=5
AUTH_EMAIL_SEND_EMAIL_HOUR=5
AUTH_EMAIL_SEND_EMAIL_DAY=10
AUTH_EMAIL_SEND_ACCOUNT_HOUR=10
AUTH_EMAIL_SEND_ACCOUNT_DAY=20
AUTH_EMAIL_SEND_IP_HOUR=30
AUTH_EMAIL_SEND_IP_DAY=100
AUTH_EMAIL_FAILURE_HOUR=20
